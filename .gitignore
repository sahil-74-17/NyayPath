# NyayPath .gitignore

# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
*.env
!.env.example
!.env.*.example
*.pem
*.key
*.cert
secrets/

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ML Artifacts & Trained Models (Keep folder, ignore model weights/binaries)
ml-service/models/*.joblib
ml-service/models/*.pkl
!ml-service/models/.gitkeep

# Uploads & Temporary Files
uploads/
tmp/
temp/

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
